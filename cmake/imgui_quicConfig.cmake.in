@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(Threads)

if(@IMGUI_QUIC_NATIVE_QUIC@ AND NOT TARGET imgui_quic::quic)
    add_library(imgui_quic::quic SHARED IMPORTED)
    set_target_properties(imgui_quic::quic PROPERTIES
        IMPORTED_LOCATION "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_LIBDIR@/libimgui_quic_quiche.so")
endif()
include("${CMAKE_CURRENT_LIST_DIR}/imgui_quic-targets.cmake")

check_required_components(imgui_quic)
